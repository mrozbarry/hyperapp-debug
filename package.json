{
  "name": "hyperapp-debug",
  "version": "2.0.0-beta.8",
  "main": "hyperapp-debug.umd.js",
  "module": "hyperapp-debug.js",
  "license": "MIT",
  "repository": "github:mrozbarry/hyperapp-debug",
  "scripts": {
    "start": "parcel serve ./src/test-bed/index.html",
    "build": "npm run build:library && npm run build:adapters",
    "build:library": "rollup --config ./rollup.config.js",
    "build:adapters": "",
    "prepack": "yarn build",
    "test": "ava",
    "test:coverage": "nyc ava"
  },
  "devDependencies": {
    "autoprefixer": "latest",
    "ava": "^3.15",
    "concurrently": "^4.1.2",
    "eslint": "^6.4.0",
    "esm": "^3.2.25",
    "hyperapp": "^2.0.18",
    "nyc": "^15.1",
    "parcel": "^2.0.1",
    "rollup": "^2.60.0",
    "sinon": "^11.1.2",
    "tailwindcss": "latest"
  },
  "peerDependencies": {
    "hyperapp": "^2"
  },
  "ava": {
    "files": [
      "src/**/*.test.js"
    ],
    "source": [
      "src/**/*.js"
    ],
    "failFast": true,
    "failWithoutassertions": false,
    "require": [
      "esm"
    ]
  }
}
